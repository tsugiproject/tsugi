<IfModule mod_rewrite.c>
    RewriteEngine on
    # config.php has secrets; FileRouter would also map /config and /config-dist
    RewriteRule ^config(-dist)?(\.php)?(/.*)?$ - [R=404,L,NS]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !=/favicon.ico
    RewriteRule ^ tsugi.php [L]
    RedirectMatch 404 /\.git
</IfModule>

<IfModule !mod_rewrite.c>
    FallbackResource tsugi.php
</IfModule>

# Default POST body cap (DDoS): reject oversized bodies before PHP.
# Needs AllowOverride Limit (or All). Dedicated folders raise this
# (lib/src/Controllers/util/upload/.htaccess is 128M for thick cartridges).
LimitRequestBody 8388608
