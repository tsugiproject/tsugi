        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;Why might sorting data on disk not always be efficient?&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="17dd3e7e-6c03-45ef-9d56-6bc07505cf4f">
                <material>
                  <mattext texttype="text/html">Random access allows faster retrieval without sorting</mattext>
                </material>
              </response_label>
              <response_label ident="4cb98fe0-8efd-477e-8abc-e8560fd64cb5">
                <material>
                  <mattext texttype="text/html">Sorting increases storage size</mattext>
                </material>
              </response_label>
              <response_label ident="e62f567b-ae18-4d32-ad69-87ef300f74dd">
                <material>
                  <mattext texttype="text/html">Sorting requires indexes</mattext>
                </material>
              </response_label>
              <response_label ident="53862aac-3e6c-4ddf-a073-116a5fb0b057">
                <material>
                  <mattext texttype="text/html">Sorting corrupts data</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
