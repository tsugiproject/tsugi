<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Generate the API docs from this directory:

        php phpDocumentor.phar run

    phpDocumentor reads this file automatically. Output is .out_phpdoc/
    and the cache is .tmp_phpdoc/. CI publishes .out_phpdoc/ to GitHub Pages.
-->
<phpdocumentor
        configVersion="3"
        xmlns="https://www.phpdoc.org"
>
    <title>Tsugi</title>
    <paths>
        <output>.out_phpdoc</output>
        <cache>.tmp_phpdoc</cache>
    </paths>
    <version number="latest">
        <api>
            <source dsn=".">
                <path>src</path>
            </source>
            <visibility>public</visibility>
            <visibility>protected</visibility>
            <visibility>private</visibility>
            <include-source>true</include-source>
        </api>
    </version>
</phpdocumentor>
