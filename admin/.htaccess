# Every admin URL is a controller. Subfolders that still hold shared
# libraries (key/, install/, ...) would otherwise be served by Apache.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule ^route\.php$ - [L]
    RewriteRule ^ route.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    FallbackResource route.php
</IfModule>
