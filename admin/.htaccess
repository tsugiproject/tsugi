# Every admin URL is a controller. Maintenance scripts live in
# admin/blob-maint/, admin/expire-maint/, and admin/install/ so those
# folder names do not match the routes (/admin/modules for install).
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule ^route-controller\.php$ - [L]
    RewriteRule ^ route-controller.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    FallbackResource route-controller.php
</IfModule>
